#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
model="${MODEL_ID:-openai/gpt-oss-120b}"
gpu_ids="${GPU_IDS:-0,1,2,3,4,5,6,7}"
target_duration="${TARGET_DURATION_S:-60}"
config="$project_dir/configs/full-8gpu.toml"

usage() {
  sed -n '2,30p' <<'HELP'
Run every AMD vLLM power scenario and generate a full text report.

Usage:
  ./run-all-scenarios [--config FILE] [--model MODEL] [--gpu-ids IDS] [--target-duration SECONDS]

Defaults:
  model:           openai/gpt-oss-120b
  GPU IDs:         0,1,2,3,4,5,6,7
  target duration: 60 measured seconds per point

The suite performs 24 points. Each point runs a short calibration, chooses a
prompt count for the target duration, samples selected-GPU package power, and
stores raw and summarized results. It refuses to start if a selected GPU has
more than 2 GiB VRAM allocated or more than 5% utilization.
HELP
}

while (($#)); do
  case "$1" in
    --model)
      model="$2"
      shift 2
      ;;
    --config)
      config="$2"
      shift 2
      ;;
    --gpu-ids)
      gpu_ids="$2"
      shift 2
      ;;
    --target-duration)
      target_duration="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

printf 'Preflight for model %s on GPUs %s\n' "$model" "$gpu_ids"
"$project_dir/bench" doctor --config "$config"

"$project_dir/bench" all \
  --config "$config" \
  --model "$model" \
  --gpu-ids "$gpu_ids" \
  --target-duration "$target_duration"

latest_sweep="$({ find "$project_dir/results" -mindepth 2 -maxdepth 3 -type f -name index.json -printf '%T@\t%h\n' || true; } | sort -nr | head -1 | cut -f2-)"
if [[ -z "$latest_sweep" || ! -f "$latest_sweep/index.json" ]]; then
  printf 'Could not identify the completed sweep directory.\n' >&2
  exit 1
fi

"$project_dir/bench" analyze "$latest_sweep" \
  --view all \
  --segments 32 \
  --cdf-output "$latest_sweep/power-cdf.svg" \
  --output "$latest_sweep/analysis.txt"

printf '\nFull suite and analysis complete: %s\n' "$latest_sweep"
